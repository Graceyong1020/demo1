<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pgm.springdemo.mapper.TimeMapper">
    <select id="getTime" resultType="String"> <!-- interface의 메소드명 "getTime"과 동일하게 설정해서 불러줌 -->
        select now()
    </select>
    <select id="getCount" resultType="int">
        select count(*) from test_tbl
    </select>
</mapper>